{
  "name": "tally-extract",
  "version": "1.5.1",
  "description": "Tally XML client based on structure spec",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dispatchTally"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/v1/company.js && node test/v1/units.js && node test/v1/withBatches.js",
    "generate:dts": "create-intellisense"
  },
  "devDependencies": {
    "create-intellisense": "^1.2.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}