### Export one stock item with batch details
POST http://localhost:9000
Content-Type: application/json
version: 1
tallyrequest: Export
type: Object
subtype: StockItem
id: Viaadi Hooks

{
  "static_variables": [
    {
      "name": "svExportFormat",
      "value": "jsonex"
    },
    {
      "name": "svCurrentCompany",
      "value": "mani9"
    }
  ],
  "fetch_list": [
    "Name",
    "Parent",
    "BaseUnits",
    "OpeningBalance",
    "BatchAllocations",
     "ClosingBalance"
  ]
}